{{define "title"}}Home{{end}}

{{define "main"}}
<section class="hero">
  {{/* fx.js draws the poster-style stadium and runs the penalty game in here. */}}
  <div class="hero-stage" id="hero-stage" aria-hidden="true"></div>
  <div class="scoreboard" aria-hidden="true">
    <span class="sb-label">Goals</span><span></span><span class="sb-label">Shots</span>
    <span class="sb-num" id="sb-goals">0</span><span class="sb-sep">:</span><span class="sb-num" id="sb-shots">0</span>
    <span class="sb-clock" id="sb-clock">Kick-off</span>
  </div>
  <div class="goal-burst" id="goal-burst" aria-hidden="true"></div>
  <div class="slowmo-tag" id="slowmo-tag" aria-hidden="true">Slow-mo replay</div>
  <div class="container hero-copy">
    <p class="kicker">// Matchday {{.CurrentYear}} · Thapar campus</p>
    <h1><span class="line">Compete.</span><span class="line">Connect.</span><span class="line">Win.</span></h1>
    <p class="lede">Discover and participate in college competitions — all in one place.</p>
    <div class="row">
      <a href="/competitions" class="btn btn-primary">Explore Competitions</a>
      <a href="/organize" class="btn">Organize an Event</a>
    </div>
    <p class="hint tiny-text"><b>Move</b> to aim · <b>click</b> to shoot · beat <b>KEEPER-BOT</b></p>
  </div>
</section>

<div class="container page stack-lg">
  <div class="grid">
    <a href="/sports" class="card category-card" data-category="SPORTS">
      <span class="cat-index">01 / 03</span>
      <h2>Sports</h2>
      <p class="small muted">Cricket, football, basketball & more</p>
      <span class="accent">Explore Sports &rarr;</span>
    </a>
    <a href="/academic" class="card category-card" data-category="ACADEMIC">
      <span class="cat-index">02 / 03</span>
      <h2>Academic</h2>
      <p class="small muted">Hackathons, quizzes, debates & more</p>
      <span class="accent">Explore Academic &rarr;</span>
    </a>
    <a href="/esports" class="card category-card" data-category="ESPORTS">
      <span class="cat-index">03 / 03</span>
      <h2>Esports</h2>
      <p class="small muted">BGMI, Valorant, FIFA & more</p>
      <span class="accent">Explore Esports &rarr;</span>
    </a>
  </div>

  {{range .Sections}}
  <section>
    <h2 class="mb">{{.Title}}</h2>
    {{template "comp-grid" .Competitions}}
  </section>
  {{end}}
</div>
{{end}}
