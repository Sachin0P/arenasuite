{{define "title"}}Settings{{end}}

{{define "main"}}
<div class="container page shell">
  {{template "organizer-side" .Section}}
  <div class="stack-lg">
    <h1>Settings</h1>
    {{range .Orgs}}
    <form method="post" action="/organizations/{{.ID}}" class="card stack">
      <div class="row between">
        <a href="/organizations/{{.ID}}" class="bold">{{.Name}}</a>
        {{if .Verified}}<span class="pill green">verified</span>{{end}}
      </div>
      <div class="grid form">
        <label class="field"><span>Name</span><input name="name" value="{{.Name}}" required></label>
        <label class="field"><span>College</span><input name="college" value="{{.College}}"></label>
      </div>
      <label class="field"><span>Logo URL</span><input name="logo" value="{{.Logo}}" placeholder="https://..."></label>
      <label class="field"><span>Description</span><textarea name="description" rows="2">{{.Description}}</textarea></label>
      <div><button class="btn btn-primary btn-sm">Save</button></div>
    </form>
    {{else}}
      {{template "empty" dict "Title" "You don't own an organization yet" "Sub" "Admins can manage every competition without one."}}
    {{end}}
  </div>
</div>
{{end}}
