{{define "title"}}Dashboard{{end}}

{{define "main"}}
<div class="container page stack-lg">
  <h1>Welcome back, {{.User.Name}}</h1>

  <div class="grid stats">
    <div class="stat"><strong>{{$.Counts.Registered}}</strong><span>Registered Competitions</span></div>
    <div class="stat"><strong>{{$.Counts.Teams}}</strong><span>Active Teams</span></div>
    <div class="stat"><strong>{{$.Counts.Upcoming}}</strong><span>Upcoming Matches</span></div>
    <div class="stat"><strong>{{$.Counts.Approved}}</strong><span>Approved Registrations</span></div>
  </div>

  {{if $.Invitations}}
  <section>
    <h2 class="mb">Team Invitations</h2>
    <div class="list">
      {{range $.Invitations}}
      <div class="list-row">
        <span><b>{{.InviterName}}</b> invited you to join <a href="/teams/{{.TeamID}}"><b>{{.TeamName}}</b></a></span>
        <div class="row">
          <form method="post" action="/invitations/{{.ID}}/accept" class="inline"><button class="btn btn-primary btn-sm">Accept</button></form>
          <form method="post" action="/invitations/{{.ID}}/reject" class="inline"><button class="btn btn-sm">Decline</button></form>
        </div>
      </div>
      {{end}}
    </div>
  </section>
  {{end}}

  <div class="grid two">
    <section>
      <div class="row between mb"><h2>My Competitions</h2><a href="/competitions" class="tiny-text muted">Explore more →</a></div>
      {{if $.Registrations}}
        <div class="list">
          {{range $.Registrations}}
          <a href="/competitions/{{.CompetitionID}}" class="list-row">
            <span><b>{{.CompetitionName}}</b>{{with .TeamName}} <span class="tiny-text muted">· {{.}}</span>{{end}}</span>
            {{template "status" .Status}}
          </a>
          {{end}}
        </div>
      {{else}}{{template "empty" dict "Title" "No registrations yet"}}{{end}}
    </section>

    <section>
      <div class="row between mb"><h2>My Teams</h2><a href="/find-team" class="tiny-text muted">Find a team →</a></div>
      {{if $.Teams}}
        <div class="list">
          {{range $.Teams}}
          <a href="/teams/{{.ID}}" class="list-row"><b>{{.Name}}</b><span class="tiny-text muted">{{.CompetitionName}}</span></a>
          {{end}}
        </div>
      {{else}}{{template "empty" dict "Title" "You're not on a team yet"}}{{end}}
    </section>

    <section>
      <h2 class="mb">Upcoming Matches</h2>
      {{if $.UpcomingMatches}}
        <div class="list">
          {{range $.UpcomingMatches}}
          <a href="/competitions/{{.CompetitionID}}#matches" class="list-row">
            <div>
              <b>{{or .TeamAName "TBD"}} vs {{or .TeamBName "TBD"}}</b>
              <p class="tiny-text muted">{{.CompetitionName}} · {{.Round}}{{with .ScheduledAt}} · {{humanDateTime .}}{{end}}</p>
            </div>
            {{template "status" .Status}}
          </a>
          {{end}}
        </div>
      {{else}}{{template "empty" dict "Title" "No upcoming matches"}}{{end}}
    </section>

    <section>
      <h2 class="mb">Recent Results</h2>
      {{if $.RecentResults}}
        <div class="list">
          {{range $.RecentResults}}
          <div class="list-row">
            <div>
              <b>{{.TeamAName}} {{with .ScoreA}}{{.}}{{end}} – {{with .ScoreB}}{{.}}{{end}} {{.TeamBName}}</b>
              <p class="tiny-text muted">{{.CompetitionName}}</p>
            </div>
            {{if .WinnerName}}<span class="tiny-text accent bold" data-category="SPORTS">{{.WinnerName}} won</span>{{else}}<span class="tiny-text muted">Draw</span>{{end}}
          </div>
          {{end}}
        </div>
      {{else}}{{template "empty" dict "Title" "No results yet"}}{{end}}
    </section>
  </div>
</div>
{{end}}
