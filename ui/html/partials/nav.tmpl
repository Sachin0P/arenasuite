{{/* The top navigation bar, included by base.tmpl. */}}
{{define "nav"}}
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">Arena<span>Suite</span></a>
    {{$p := .Path}}
    <nav class="nav-links">
      <a href="/" {{if eq $p "/"}}class="active"{{end}}>Home</a>
      <a href="/sports" {{if eq $p "/sports"}}class="active"{{end}}>Sports</a>
      <a href="/academic" {{if eq $p "/academic"}}class="active"{{end}}>Academic</a>
      <a href="/esports" {{if eq $p "/esports"}}class="active"{{end}}>Esports</a>
      <a href="/find-team" {{if eq $p "/find-team"}}class="active"{{end}}>Find a Team</a>
      {{if .User}}<a href="/dashboard" {{if eq $p "/dashboard"}}class="active"{{end}}>My Competitions</a>{{end}}
      <a href="/organize" {{if eq $p "/organize"}}class="active"{{end}}>Organize</a>
    </nav>

    <div class="nav-right">
      {{if .User}}
        {{if .User.IsOrganizer}}<a href="/organizer" class="desktop-only">Organizer Dashboard</a>{{end}}
        {{if .User.IsAdmin}}<a href="/admin" class="desktop-only">Admin Panel</a>{{end}}
        <a href="/notifications" class="badge-link">Notifications
          <span id="unread" class="badge" data-count="{{.Unread}}" {{if eq .Unread 0}}hidden{{end}}>{{if gt .Unread 9}}9+{{else}}{{.Unread}}{{end}}</span>
        </a>
        <details class="menu desktop-only">
          <summary>{{template "avatar" .User}}</summary>
          <div class="menu-panel">
            <a href="/profile">Profile</a>
            <a href="/dashboard">Dashboard</a>
            <form method="post" action="/auth/logout"><button class="danger">Sign out</button></form>
          </div>
        </details>
      {{else}}
        <a href="/auth/login" class="btn btn-primary btn-sm desktop-only">Sign in</a>
      {{end}}

      {{/* On small screens the same links move into this menu. */}}
      <details class="menu mobile-only">
        <summary aria-label="Menu" class="btn btn-sm">☰</summary>
        <div class="menu-panel">
          <a href="/">Home</a>
          <a href="/sports">Sports</a>
          <a href="/academic">Academic</a>
          <a href="/esports">Esports</a>
          <a href="/find-team">Find a Team</a>
          {{if .User}}<a href="/dashboard">My Competitions</a>{{end}}
          <a href="/organize">Organize</a>
          {{if .User}}
            {{if .User.IsOrganizer}}<a href="/organizer">Organizer Dashboard</a>{{end}}
            {{if .User.IsAdmin}}<a href="/admin">Admin Panel</a>{{end}}
            <a href="/profile">Profile</a>
            <form method="post" action="/auth/logout"><button class="danger">Sign out</button></form>
          {{else}}
            <a href="/auth/login"><b>Sign in</b></a>
          {{end}}
        </div>
      </details>
    </div>
  </div>
</header>
{{end}}
