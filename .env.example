# Copy this file to .env and fill it in.

PORT=4000
# Public address of the site. Google redirects back to BASE_URL/auth/google/callback.
BASE_URL=http://localhost:4000

# PostgreSQL connection URL. Keep it private: it contains the database password.
#   Homebrew / Postgres.app:  postgres://YOUR_MAC_USERNAME@localhost:5432/arenasuite?sslmode=disable
#   Docker (postgres image):  postgres://postgres:postgres@localhost:5432/arenasuite?sslmode=disable
#   Neon / Supabase:          copy the connection string from their dashboard (uses sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arenasuite?sslmode=disable

# All times on the site are shown and entered in this timezone
TIMEZONE=Asia/Kolkata

# Signs the login cookie. Use a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# Google OAuth "Web application" client (Google Cloud Console → Credentials).
# Add BASE_URL/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Only Google accounts on this email domain may sign in
ALLOWED_EMAIL_DOMAIN=thapar.edu
# College pre-filled for new users (they can still change it on their profile)
DEFAULT_COLLEGE=Thapar University

# Comma-separated emails promoted to admin when they sign in (first login or
# any later one). One-way: removing an email later doesn't revoke admin.
ADMIN_EMAILS=

# Development only: lets you sign in as any user from the login page,
# without Google. NEVER turn this on in production.
DEV_LOGIN=false

# Set to true when deployed behind a hosting proxy (Render, Fly, Railway,
# Caddy...) so rate limiting sees each visitor's real address. Leave false locally.
TRUST_PROXY=false
